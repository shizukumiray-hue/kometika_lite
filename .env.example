# ==========================================
# KOMETIKA-LITE CONFIGURATION
# ==========================================

# 1. TELEGRAM BOT CREDENTIALS (Wajib)
# Dapatkan API ID & Hash dari https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=kometika_bot

# 2. OWNER / ADMIN CONFIGURATION (Wajib untuk akses /getlog, /on, /off)
# Telegram User ID angka milik kamu (bisa didapat via /getid)
OWNER_ID=123456789

# 3. GROUP LOG (Opsional - untuk notifikasi bot start & log error real-time ke Telegram)
# GROUP_ID: ID Supergroup/Channel Telegram (contoh: -1001234567890)
# GROUP_HASH: Access Hash channel/grup (didapat via /getid di grup)
GROUP_ID=
GROUP_HASH=

# 4. TERABOX EXTRACTOR COOKIE (Opsional)
# Masukkan cookie 'ndus' dari akun terabox jika ingin download file besar / bypass limit
TERABOX_NDUS=
# TERABOX_COOKIE=
